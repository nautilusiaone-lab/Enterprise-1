        // Variables globales
        let enterpriseMap;
        let mapInitialized = false;
        let satelliteLayer = null;
        let weatherLayer = null;
        let currentsLayer = null;
        
        // Inicialización cuando el DOM esté completamente cargado
        document.addEventListener('DOMContentLoaded', function() {
            // Ocultar loader cuando todo esté listo
            setTimeout(() => {
                document.getElementById('loader').classList.add('hidden');
            }, 3000);
            
            initializeEnterprisePlatform();
            setupEnterpriseDemo();
            setupEnterpriseNavigation();
            loadEnterpriseData();
            setupAnimations();
            setupPerformanceOptimizations();
            initializeChart();
            setupContactForm();
            initNeuralNetworkVisualization();
            initParticles();
            setupSatelliteIntegration();
        });
        
        function initializeEnterprisePlatform() {
            // Inicialización diferida del mapa para mejor rendimiento
            if (!mapInitialized) {
                enterpriseMap = L.map('enterprise-map').setView([25, 0], 2);
                
                // Configuración de mapa enterprise
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap contributors',
                    maxZoom: 18
                }).addTo(enterpriseMap);
                
                // Añadir capas adicionales
                addEnterpriseLayers();
                
                // Añadir rutas enterprise
                addEnterpriseRoutes();
                
                // Configurar controles de mapa
                L.control.zoom({
                    position: 'bottomright'
                }).addTo(enterpriseMap);
                
                mapInitialized = true;
            }
            
            // Inicializar datos en tiempo real
            simulateRealTimeEnterpriseData();
        }
        
        function addEnterpriseLayers() {
            // Capa de satélite (se añadirá cuando el usuario la active)
            satelliteLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                attribution: '© Esri',
                maxZoom: 18
            });
            
            // Capa de tráfico marítimo
            const trafficLayer = L.tileLayer('https://tileservice.charts.noaa.gov/tiles/50000_1/{z}/{x}/{y}.png', {
                attribution: 'NOAA',
                maxZoom: 15
            });
            
            // Añadir control de capas
            L.control.layers({
                'OpenStreetMap': L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png'),
                'Satélite': satelliteLayer,
                'Tráfico Marítimo': trafficLayer
            }).addTo(enterpriseMap);
        }
        
        function setupSatelliteIntegration() {
            // Configurar los botones de control satelital
            document.getElementById('toggle-satellite').addEventListener('click', function() {
                if (enterpriseMap.hasLayer(satelliteLayer)) {
                    enterpriseMap.removeLayer(satelliteLayer);
                    this.innerHTML = '<i class="fas fa-satellite"></i> Activar Vista Satelital';
                } else {
                    enterpriseMap.addLayer(satelliteLayer);
                    this.innerHTML = '<i class="fas fa-satellite"></i> Desactivar Vista Satelital';
                }
            });
            
            document.getElementById('toggle-weather').addEventListener('click', function() {
                // Simular capa meteorológica
                if (weatherLayer && enterpriseMap.hasLayer(weatherLayer)) {
                    enterpriseMap.removeLayer(weatherLayer);
                    this.innerHTML = '<i class="fas fa-cloud-sun"></i> Activar Capa Meteorológica';
                } else {
                    // En una implementación real, aquí se conectaría con una API de datos meteorológicos
                    weatherLayer = L.layerGroup().addTo(enterpriseMap);
                    // Simular datos meteorológicos
                    simulateWeatherData(weatherLayer);
                    this.innerHTML = '<i class="fas fa-cloud-sun"></i> Desactivar Capa Meteorológica';
                }
            });
            
            document.getElementById('toggle-currents').addEventListener('click', function() {
                // Simular capa de corrientes marinas
                if (currentsLayer && enterpriseMap.hasLayer(currentsLayer)) {
                    enterpriseMap.removeLayer(currentsLayer);
                    this.innerHTML = '<i class="fas fa-water"></i> Activar Corrientes Marinas';
                } else {
                    // En una implementación real, aquí se conectaría con una API de datos oceánicos
                    currentsLayer = L.layerGroup().addTo(enterpriseMap);
                    // Simular datos de corrientes
                    simulateCurrentsData(currentsLayer);
                    this.innerHTML = '<i class="fas fa-water"></i> Desactivar Corrientes Marinas';
                }
            });
        }
        
        function simulateWeatherData(layer) {
            // Simular datos meteorológicos para la demo
            const weatherPoints = [
                { lat: 35, lng: -30, type: 'storm', intensity: 'high' },
                { lat: 40, lng: -20, type: 'cloud', intensity: 'medium' },
                { lat: 25, lng: -10, type: 'wind', intensity: 'low' },
                { lat: 15, lng: 0, type: 'clear', intensity: 'none' }
            ];
            
            weatherPoints.forEach(point => {
                const icon = L.divIcon({
                    className: 'weather-icon',
                    html: `<div style="background:${getWeatherColor(point.type)}; width:20px; height:20px; border-radius:50%; border:2px solid white; box-shadow:0 0 10px ${getWeatherColor(point.type)};"></div>`,
                    iconSize: [20, 20]
                });
                
                L.marker([point.lat, point.lng], { icon: icon })
                    .addTo(layer)
                    .bindPopup(`<strong>${point.type.toUpperCase()}</strong><br>Intensidad: ${point.intensity}`);
            });
        }
        
        function simulateCurrentsData(layer) {
            // Simular datos de corrientes marinas para la demo
            const currentPoints = [
                { lat: 30, lng: -25, direction: 45, speed: '2.5 nudos' },
                { lat: 35, lng: -15, direction: 120, speed: '1.8 nudos' },
                { lat: 20, lng: -5, direction: 300, speed: '3.2 nudos' },
                { lat: 10, lng: 5, direction: 200, speed: '2.1 nudos' }
            ];
            
            currentPoints.forEach(point => {
                const icon = L.divIcon({
                    className: 'current-icon',
                    html: `<div style="transform:rotate(${point.direction}deg); color:blue; font-size:24px;"><i class="fas fa-arrow-right"></i></div>`,
                    iconSize: [24, 24]
                });
                
                L.marker([point.lat, point.lng], { icon: icon })
                    .addTo(layer)
                    .bindPopup(`<strong>Corriente Marina</strong><br>Dirección: ${point.direction}°<br>Velocidad: ${point.speed}`);
            });
        }
        
        function getWeatherColor(type) {
            const colors = {
                'storm': '#ef4444',
                'cloud': '#6b7280',
                'wind': '#3b82f6',
                'clear': '#10b981'
            };
            return colors[type] || '#000';
        }
        
        function addEnterpriseRoutes() {
            const enterpriseRoutes = {
                'asia-europe': [
                    [1.35, 103.8], [5.41, 100.33], [13.75, 100.48],
                    [25.07, 121.56], [35.67, 139.65], [36.12, -5.37], [51.92, 4.48]
                ],
                'america-europe': [
                    [40.71, -74.01], [43.65, -79.38], [51.51, -0.12],
                    [53.55, 9.99], [55.68, 12.57]
                ],
                'asia-america': [
                    [31.23, 121.47], [35.67, 139.65], [37.77, -122.41],
                    [34.05, -118.24], [32.72, -117.16]
                ],
                'transpacific': [
                    [35.68, 139.76], [37.77, -122.41], [34.05, -118.24],
                    [32.72, -117.16], [47.61, -122.34]
                ]
            };
            
            // Limpiar mapa primero
            enterpriseMap.eachLayer(function(layer) {
                if (layer instanceof L.Polyline || layer instanceof L.Marker) {
                    enterpriseMap.removeLayer(layer);
                }
            });
            
            Object.entries(enterpriseRoutes).forEach(([name, points]) => {
                // Crear polyline para la ruta
                const polyline = L.polyline(points, {
                    color: getEnterpriseRouteColor(name),
                    weight: 6,
                    opacity: 0.9,
                    smoothFactor: 1,
                    dashArray: name === 'transpacific' ? '10, 15' : null
                }).addTo(enterpriseMap);
                
                // Añadir marcadores de inicio y fin
                L.marker(points[0], {
                    icon: L.divIcon({
                        className: 'enterprise-start-marker',
                        html: '<div style="background:#08c792; width:25px; height:25px; border-radius:50%; border:4px solid white; box-shadow:0 4px 20px rgba(8, 199, 146, 0.4);"></div>',
                        iconSize: [25, 25]
                    })
                }).addTo(enterpriseMap).bindPopup(`
                    <strong>Origen: ${getEnterpriseLocationName(points[0])}</strong><br>
                    <em>Ruta: ${name.toUpperCase()}</em>
                `);
                
                L.marker(points[points.length-1], {
                    icon: L.divIcon({
                        className: 'enterprise-end-marker',
                        html: '<div style="background:#ef4444; width:25px; height:25px; border-radius:50%; border:4px solid white; box-shadow:0 4px 20px rgba(239, 68, 68, 0.4);"></div>',
                        iconSize: [25, 25]
                    })
                }).addTo(enterpriseMap).bindPopup(`
                    <strong>Destino: ${getEnterpriseLocationName(points[points.length-1])}</strong><br>
                    <em>Ruta: ${name.toUpperCase()}</em>
                `);
                
                // Añadir marcadores intermedios para rutas enterprise
                if (points.length > 4) {
                    points.slice(1, -1).forEach((point, index) {
                        if (index % 2 === 0) { // Marcadores cada dos puntos
                            L.marker(point, {
                                icon: L.divIcon({
                                    className: 'enterprise-mid-marker',
                                    html: '<div style="background:#7c3aed; width:15px; height:15px; border-radius:50%; border:3px solid white; box-shadow:0 3px 15px rgba(124, 58, 237, 0.4);"></div>',
                                    iconSize: [15, 15]
                                })
                            }).addTo(enterpriseMap).bindPopup(`Punto de paso ${index + 1}`);
                        }
                    });
                }
            });
            
            // Ajustar la vista para mostrar todas las rutas
            const allPoints = Object.values(enterpriseRoutes).flat();
            const bounds = L.latLngBounds(allPoints);
            enterpriseMap.fitBounds(bounds, { padding: [100, 100] });
        }
        
        function getEnterpriseRouteColor(routeName) {
            const colors = {
                'asia-europe': '#1e4dd8',
                'america-europe': '#08c792',
                'asia-america': '#7c3aed',
                'transpacific': '#fbbf24'
            };
            return colors[routeName] || '#000';
        }
        
        function getEnterpriseLocationName(coords) {
            const locations = {
                '1.35,103.8': 'Singapur',
                '51.92,4.48': 'Róterdam',
                '40.71,-74.01': 'Nueva York',
                '53.55,9.99': 'Hamburgo',
                '31.23,121.47': 'Shanghái',
                '34.05,-118.24': 'Los Ángeles',
                '35.68,139.76': 'Tokio',
                '37.77,-122.41': 'San Francisco',
                '55.68,12.57': 'Copenhague',
                '32.72,-117.16': 'San Diego',
                '47.61,-122.34': 'Seattle'
            };
            return locations[coords.join(',')] || 'Ubicación Enterprise';
        }
        
