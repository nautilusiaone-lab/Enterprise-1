<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nautilus AI Enterprise - Plataforma de Optimización Marítima con IA y Satélite</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.10.0/dist/tf.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.3.2/papaparse.min.js"></script>
    <script src="https://cdn.jsdelivr.net/particles.js/2.0.0/particles.min.js"></script>
    <style>
        :root {
            --primary-dark: #0a1f3a;
            --primary: #1e4dd8;
            --primary-light: #e0eaff;
            --accent: #08c792;
            --accent-dark: #06a57d;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --carbon: #0d9488;
            --premium: #7c3aed;
            --enterprise: #1e3a8a;
            --gold: #fbbf24;
            --satellite: #8b5cf6;
            --text-dark: #111827;
            --text-light: #f9fafb;
            --gray: #6b7280;
            --light-bg: #f8fafc;
            --whatsapp: #25D366;
            --whatsapp-dark: #128C7E;
            --gradient-enterprise: linear-gradient(135deg, #0a1f3a 0%, #1e3a8a 50%, #1e4dd8 100%);
            --gradient-gold: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
            --gradient-accept: linear-gradient(135deg, #08c792 0%, #059669 100%);
            --gradient-satellite: linear-gradient(135deg, #8b5cf6 0%, #4c1d95 100%);
            --shadow-2xl: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            --shadow-3xl: 0 35px 60px -15px rgba(0, 0, 0, 0.3);
            --border-gold: 1px solid rgba(251, 191, 36, 0.3);
            --glow-primary: 0 0 20px rgba(30, 77, 216, 0.5);
            --glow-accent: 0 0 20px rgba(8, 199, 146, 0.5);
            --glow-satellite: 0 0 20px rgba(139, 92, 246, 0.5);
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
        }
        
        body {
            color: var(--text-dark);
            line-height: 1.7;
            overflow-x: hidden;
            background: var(--light-bg);
        }
        
        .container {
            width: 100%;
            max-width: 1600px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Loader Enterprise con tema satelital */
        .loader-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--gradient-enterprise);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            transition: opacity 0.8s ease-out, visibility 0.8s;
        }

        .loader-container.hidden {
            opacity: 0;
            visibility: hidden;
        }

        .satellite-loader {
            width: 150px;
            height: 150px;
            position: relative;
        }

        .satellite-loader .orbit {
            width: 100%;
            height: 100%;
            border: 3px solid rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            position: relative;
        }

        .satellite-loader .satellite {
            position: absolute;
            top: 50%;
            left: 0;
            width: 20px;
            height: 20px;
            background: var(--satellite);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            animation: orbit 3s linear infinite;
            box-shadow: var(--glow-satellite);
        }

        .loader-text {
            margin-top: 25px;
            color: white;
            font-size: 1.3rem;
            font-weight: 600;
            text-align: center;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
        }
        
        @keyframes orbit {
            0% { transform: translate(-50%, -50%) rotate(0deg) translateX(75px) rotate(0deg); }
            100% { transform: translate(-50%, -50%) rotate(360deg) translateX(75px) rotate(-360deg); }
        }
        
        /* Enterprise Header Mejorado */
        .enterprise-header {
            background: var(--gradient-enterprise);
            color: white;
            padding: 16px 0;
            font-size: 1rem;
            text-align: center;
            position: relative;
            overflow: hidden;
            border-bottom: var(--border-gold);
        }
        
        .header-badge {
            background: var(--gradient-satellite);
            padding: 8px 20px;
            border-radius: 25px;
            font-weight: 700;
            margin-left: 15px;
            color: white;
            box-shadow: 0 4px 15px rgba(139, 92, 246, 0.4);
            animation: pulse 2s infinite;
        }
        
        .header-glow {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 50% 0%, rgba(139, 92, 246, 0.2) 0%, transparent 70%);
            pointer-events: none;
        }
        
        /* Navigation Enterprise Mejorado */
        header {
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(30px);
            color: var(--text-dark);
            padding: 0;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 15px;
            font-weight: 800;
            font-size: 2.4rem;
            color: var(--enterprise);
            position: relative;
        }
        
        .logo i {
            color: var(--accent);
            font-size: 3rem;
            text-shadow: var(--glow-accent);
        }
        
        .logo::after {
            content: 'ENTERPRISE';
            position: absolute;
            top: -12px;
            right: -95px;
            font-size: 0.8rem;
            font-weight: 800;
            color: var(--gold);
            background: rgba(30, 58, 138, 0.15);
            padding: 5px 12px;
            border-radius: 15px;
            border: var(--border-gold);
        }
        
        nav ul {
            display: flex;
            list-style: none;
            gap: 40px;
            align-items: center;
        }
        
        nav a {
            color: var(--text-dark);
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            padding: 12px 24px;
            border-radius: 15px;
            position: relative;
            font-size: 1.1rem;
        }
        
        nav a:hover {
            color: var(--primary);
            background: linear-gradient(135deg, rgba(30, 77, 216, 0.05) 0%, rgba(30, 58, 138, 0.1) 100%);
            transform: translateY(-2px);
        }
        
        nav a::before {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 3px;
            background: var(--gradient-enterprise);
            border-radius: 3px;
            transition: width 0.3s ease;
        }
        
        nav a:hover::before {
            width: 40px;
        }
        
        .cta-button {
            background: var(--gradient-enterprise);
            color: white !important;
            padding: 16px 32px !important;
            border-radius: 18px;
            font-weight: 700;
            box-shadow: 0 10px 30px rgba(30, 58, 138, 0.4);
            transition: all 0.3s ease;
            border: none;
            position: relative;
            overflow: hidden;
        }
        
        .cta-button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
            transition: left 0.7s;
        }
        
        .cta-button:hover::before {
            left: 100%;
        }
        
        .cta-button:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 15px 40px rgba(30, 58, 138, 0.5);
        }
        
        /* Hero Section Enterprise Mejorado */
        .hero-enterprise {
            padding: 200px 0 150px;
            background: linear-gradient(112deg, rgba(10, 31, 58, 0.92) 0%, rgba(30, 58, 138, 0.95) 100%), url('https://images.unsplash.com/photo-1561715276-a2d087060f1d?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80') no-repeat center center/cover;
            color: white;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        #particles-js {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
        }
        
        .hero-content {
            position: relative;
            z-index: 3;
            max-width: 1100px;
            margin: 0 auto;
        }
        
        .hero-badge {
            background: var(--gradient-satellite);
            color: white;
            padding: 14px 30px;
            border-radius: 30px;
            font-weight: 800;
            font-size: 1.2rem;
            display: inline-block;
            margin-bottom: 40px;
            box-shadow: 0 10px 30px rgba(139, 92, 246, 0.4);
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
        
        .hero h1 {
            font-size: 4.5rem;
            margin-bottom: 40px;
            line-height: 1.1;
            font-weight: 900;
            background: linear-gradient(135deg, #ffffff 0%, var(--accent) 30%, var(--gold) 60%, var(--satellite) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 5px 40px rgba(255, 255, 255, 0.2);
        }
        
        .hero p {
            font-size: 1.8rem;
            margin: 0 auto 60px;
            opacity: 0.95;
            font-weight: 300;
            line-height: 1.6;
            max-width: 900px;
        }
        
        .hero-subtitle {
            font-size: 1.5rem;
            margin: 30px auto;
            max-width: 800px;
            color: var(--accent-light);
            font-weight: 400;
        }
        
        .btn-enterprise {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 25px 50px;
            background: var(--gradient-enterprise);
            color: white;
            text-decoration: none;
            border-radius: 18px;
            font-weight: 800;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: none;
            cursor: pointer;
            font-size: 1.3rem;
            margin: 20px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 15px 40px rgba(30, 58, 138, 0.4);
        }
        
        .btn-enterprise::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
            transition: left 0.7s;
        }
        
        .btn-enterprise:hover::before {
            left: 100%;
        }
        
        .btn-enterprise:hover {
            transform: translateY(-5px) scale(1.05);
            box-shadow: 0 25px 60px rgba(30, 58, 138, 0.5);
        }
        
        .btn-enterprise i {
            margin-right: 18px;
            font-size: 1.6rem;
        }
        
        .btn-outline-white {
            background: transparent;
            border: 3px solid white;
            color: white;
            backdrop-filter: blur(10px);
        }
        
        .btn-outline-white:hover {
            background: white;
            color: var(--primary-dark);
            transform: translateY(-5px);
        }
        
        /* Sección de Servicios Satelitales */
        .satellite-services {
            padding: 120px 0;
            background: linear-gradient(135deg, #f8fafc 0%, #f0f4ff 100%);
        }
        
        .section-title {
            text-align: center;
            margin-bottom: 70px;
        }
        
        .section-title h2 {
            font-size: 3.5rem;
            color: var(--primary-dark);
            margin-bottom: 25px;
            font-weight: 900;
        }
        
        .section-title p {
            font-size: 1.5rem;
            color: var(--gray);
            max-width: 800px;
            margin: 0 auto;
            line-height: 1.6;
        }
        
        .satellite-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
            gap: 50px;
            margin-top: 70px;
        }
        
        .satellite-card {
            background: white;
            padding: 45px;
            border-radius: 25px;
            box-shadow: var(--shadow-2xl);
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(0, 0, 0, 0.05);
            text-align: center;
        }
        
        .satellite-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: var(--gradient-satellite);
        }
        
        .satellite-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow-3xl);
        }
        
        .satellite-icon {
            font-size: 4rem;
            margin-bottom: 30px;
            background: var(--gradient-satellite);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            height: 90px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .satellite-card h3 {
            color: var(--primary-dark);
            margin-bottom: 25px;
            font-size: 2rem;
            font-weight: 800;
        }
        
        .satellite-card p {
            color: var(--gray);
            line-height: 1.6;
            font-size: 1.2rem;
            margin-bottom: 30px;
        }
        
        .satellite-features {
            list-style: none;
            margin-top: 25px;
        }
        
        .satellite-features li {
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            font-size: 1.1rem;
            color: var(--gray);
        }
        
        .satellite-features li i {
            margin-right: 15px;
            color: var(--satellite);
            font-size: 1.3rem;
        }
        
        /* Sección de Tecnología IA Avanzada */
        .ai-technology {
            padding: 120px 0;
            background: var(--gradient-enterprise);
            color: white;
            position: relative;
            overflow: hidden;
        }
        
        .ai-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 70px;
            align-items: center;
        }
        
        .ai-visualization {
            position: relative;
            height: 600px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 25px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: var(--glow-satellite);
        }
        
        .ai-neural-network {
            width: 100%;
            height: 100%;
            position: relative;
        }
        
        .ai-text h2 {
            font-size: 4rem;
            margin-bottom: 40px;
            font-weight: 900;
            background: linear-gradient(135deg, #ffffff 0%, var(--accent) 50%, var(--satellite) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .ai-text p {
            font-size: 1.5rem;
            margin-bottom: 40px;
            line-height: 1.6;
            opacity: 0.95;
        }
        
        .ai-features {
            list-style: none;
            margin-top: 40px;
        }
        
        .ai-features li {
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            font-size: 1.3rem;
        }
        
        .ai-features li i {
            margin-right: 20px;
            color: var(--accent);
            font-size: 1.8rem;
            background: var(--gradient-accent);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        /* Dashboard Enterprise Mejorado */
        .enterprise-dashboard {
            padding: 120px 0;
            background: white;
        }
        
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 40px;
            margin-top: 70px;
        }
        
        .dashboard-card {
            background: white;
            padding: 40px;
            border-radius: 25px;
            box-shadow: var(--shadow-2xl);
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(0, 0, 0, 0.05);
        }
        
        .dashboard-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: var(--gradient-enterprise);
        }
        
        .dashboard-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow-3xl);
        }
        
        .dashboard-card i {
            font-size: 3.5rem;
            color: var(--accent);
            margin-bottom: 30px;
            background: var(--gradient-enterprise);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .dashboard-card h3 {
            color: var(--primary-dark);
            margin-bottom: 25px;
            font-size: 1.8rem;
            font-weight: 800;
        }
        
        .dashboard-card p {
            color: var(--gray);
            line-height: 1.6;
            font-size: 1.2rem;
            margin-bottom: 30px;
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
            margin-top: 25px;
        }
        
        .stat-item {
            text-align: center;
            padding: 20px;
            background: var(--light-bg);
            border-radius: 15px;
        }
        
        .stat-value {
            font-size: 2.5rem;
            font-weight: 900;
            color: var(--primary-dark);
            margin-bottom: 8px;
        }
        
        .stat-label {
            color: var(--gray);
            font-weight: 500;
            font-size: 1rem;
        }

        /* Gráfico en tiempo real mejorado */
        .realtime-chart {
            background: white;
            padding: 50px;
            border-radius: 25px;
            box-shadow: var(--shadow-2xl);
            margin-top: 70px;
            text-align: center;
            border: 1px solid rgba(0, 0, 0, 0.05);
        }

        .realtime-chart h3 {
            color: var(--primary-dark);
            margin-bottom: 40px;
            font-size: 2.2rem;
            font-weight: 800;
        }

        .chart-container {
            position: relative;
            height: 450px;
            width: 100%;
        }
        
        /* Demo Interactiva Enterprise Mejorada */
        .demo-enterprise {
            padding: 120px 0;
            background: linear-gradient(135deg, var(--light-bg) 0%, #f0f4ff 100%);
        }
        
        .demo-container-enterprise {
            background: white;
            border-radius: 30px;
            box-shadow: var(--shadow-3xl);
            padding: 60px;
            margin-top: 60px;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(0, 0, 0, 0.05);
        }
        
        .demo-container-enterprise::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 400px;
            height: 400px;
            background: var(--gradient-enterprise);
            border-radius: 0 0 0 400px;
            opacity: 0.03;
        }
        
        .demo-controls-enterprise {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 45px;
            margin-bottom: 55px;
        }
        
        .control-group-enterprise {
            margin-bottom: 40px;
        }
        
        .control-group-enterprise label {
            display: block;
            margin-bottom: 20px;
            font-weight: 800;
            color: var(--primary-dark);
            font-size: 1.3rem;
        }
        
        .control-group-enterprise input,
        .control-group-enterprise select {
            width: 100%;
            padding: 25px 30px;
            border: 2px solid #e5e7eb;
            border-radius: 18px;
            font-size: 1.2rem;
            transition: all 0.3s ease;
            background: white;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        }
        
        .control-group-enterprise input:focus,
        .control-group-enterprise select:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 5px rgba(8, 199, 146, 0.1);
            transform: translateY(-3px);
        }
        
        .map-container-enterprise {
            width: 100%;
            height: 600px;
            border-radius: 25px;
            overflow: hidden;
            margin: 55px 0;
            box-shadow: var(--shadow-2xl);
            border: 1px solid rgba(0, 0, 0, 0.1);
        }
        
        #enterprise-map {
            height: 100%;
            width: 100%;
            border-radius: 25px;
        }
        
        .satellite-controls {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin: 20px 0;
        }
        
        .satellite-toggle {
            background: var(--gradient-satellite);
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(139, 92, 246, 0.3);
        }
        
        .satellite-toggle:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(139, 92, 246, 0.4);
        }
        
        .results-grid-enterprise {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 40px;
            margin-top: 55px;
        }
        
        .result-card-enterprise {
            background: white;
            padding: 35px;
            border-radius: 20px;
            text-align: center;
            box-shadow: var(--shadow-2xl);
            transition: all 0.4s ease;
            border: 1px solid rgba(0, 0, 0, 0.05);
            position: relative;
            overflow: hidden;
        }
        
        .result-card-enterprise::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: var(--gradient-enterprise);
        }
        
        .result-card-enterprise:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-3xl);
        }
        
        .result-value-enterprise {
            font-size: 3.2rem;
            font-weight: 900;
            color: var(--primary-dark);
            margin: 25px 0;
            background: var(--gradient-enterprise);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .result-label-enterprise {
            color: var(--gray);
            font-weight: 600;
            font-size: 1.2rem;
        }
        
        /* Sección de Comparativa */
        .competitive-comparison {
            padding: 120px 0;
            background: white;
        }
        
        .comparison-table {
            width: 100%;
