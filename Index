        function calculateEnterpriseOptimization() {
            const route = document.getElementById('enterprise-route').value;
            const vessel = document.getElementById('enterprise-vessel').value;
            const weather = document.getElementById('enterprise-weather').value;
            const cargoLoad = parseInt(document.getElementById('enterprise-cargo').value);
            
            // Simular cálculo enterprise avanzado
            const baseResults = {
                'asia-europe': { fuel: 26.8, emission: 32.5, time: 19.7, carbon: 68500 },
                'america-europe': { fuel: 22.2, emission: 27.7, time: 16.3, carbon: 57500 },
                'asia-america': { fuel: 24.8, emission: 30.5, time: 17.2, carbon: 63200 },
                'transpacific': { fuel: 25.3, emission: 31.0, time: 17.8, carbon: 65100 }
            };
            
            const results = { ...baseResults[route] };
            
            // Ajustar basado en tipo de buque enterprise
            const vesselFactors = {
                'container': { fuel: 1.0, emission: 1.0 },
                'bulk': { fuel: 0.9, emission: 0.95 },
                'tanker': { fuel: 1.1, emission: 1.15 },
                'lng': { fuel: 0.85, emission: 0.8 }
            };
            
            const factor = vesselFactors[vessel];
            results.fuel *= factor.fuel;
            results.emission *= factor.emission;
            
            // Ajustar basado en condiciones climáticas
            const weatherFactors = {
                'optimal': 1.1,
                'moderate': 1.0,
                'adverse': 0.9,
                'storm': 0.8
            };
            
            const weatherFactor = weatherFactors[weather];
            results.fuel *= weatherFactor;
            results.emission *= weatherFactor;
            
            // Ajustar basado en carga (optimización enterprise)
            const cargoFactor = 0.8 + (cargoLoad / 100 * 0.4); // 0.8-1.2 range
            results.fuel *= cargoFactor;
            results.emission *= cargoFactor;
            
            // Añadir factor aleatorio para simular datos reales
            const randomFactor = 0.95 + (Math.random() * 0.1);
            results.fuel *= randomFactor;
            results.emission *= randomFactor;
            
            // Actualizar UI
            updateEnterpriseResultsUI(results);
            
            // Animación de resultados
            highlightEnterpriseResults();
            
            // Actualizar mapa
            updateEnterpriseMap();
        }
        
        function updateEnterpriseResultsUI(results) {
            document.getElementById('enterprise-fuel').textContent = results.fuel.toFixed(1) + '%';
            document.getElementById('enterprise-emission').textContent = results.emission.toFixed(1) + '%';
            document.getElementById('enterprise-time').textContent = results.time.toFixed(1) + '%';
            document.getElementById('enterprise-carbon').textContent = '$' + Math.round(results.carbon).toLocaleString();
        }
        
        function updateEnterpriseResults() {
            // Actualización en tiempo real de resultados
            calculateEnterpriseOptimization();
        }
        
        function updateEnterpriseMap() {
            addEnterpriseRoutes();
        }
        
        function highlightEnterpriseResults() {
            const results = document.querySelectorAll('.result-value-enterprise');
            results.forEach(result => {
                result.style.transition = 'all 0.5s cubic-bezier(0.4, 0, 0.2, 1)';
                result.style.transform = 'scale(1.15)';
                result.style.color = '#08c792';
                
                setTimeout(() => {
                    result.style.transform = 'scale(1)';
                    result.style.color = '';
                }, 500);
            });
        }
        
